{
  "expo": {
    "name": "GritMath",
    "slug": "gritmath",
    "version": "2.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "gritmath",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.GritMath"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "com.anonymous.GritMath",
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1157854963201430~7548198352",
          "iosAppId": "ca-app-pub-1157854963201430~7548198352"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.20"
          }
        }
      ]
    ]
  }
}
